# Local development needs no credentials. Accepted values: mock | live.
# Vercel requires an explicit mode; set live and a server-only key for real AI.
AI_MODE=mock
# Used only in live mode, on the server. Never use NEXT_PUBLIC for credentials.
ANTHROPIC_API_KEY=
# Default live model; account access and output quality need an explicit live smoke/evaluation.
ANTHROPIC_MODEL=claude-sonnet-5-5
